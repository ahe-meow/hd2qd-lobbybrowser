<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verify.exe: checks the built HD2QD.LobbyBrowswer.dll against the plugin contract of
       HD2 Mod Quick Deploy (docs/plugin-authors.md) and runs one live scan through it.
       It loads the DLL as the manager would, by reflection: it links none of its sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Verify</AssemblyName>
    <RootNamespace>Hd2Qd.Verify</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
