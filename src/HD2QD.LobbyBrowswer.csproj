<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2QD.LobbyBrowswer.dll: a plugin of HD2 Mod Quick Deploy, a window of its own
       (BrowserWindow.cs). .NET Framework 4.8, as the manager; the file name must be
       HD2QD.<name>.dll. It shares no types with the manager: strings, numbers, bools,
       delegates and Json shapes only. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HD2QD.LobbyBrowswer</AssemblyName>
    <RootNamespace>Hd2Qd.LobbyBrowswer</RootNamespace>
    <Version>1.0.0</Version>
    <Product>HD2QD Lobby Browser</Product>
    <Company>ahe-meow</Company>
    <Copyright>MIT License</Copyright>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)\..=src</PathMap>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- the text, one file per language (Lang\<tag>.json), embedded as Lang.<tag>.json: Words.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
    <EmbeddedResource Include="Data\*.json" LogicalName="Data.%(Filename).json" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
